generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication & Users ───

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("STUDENT") // ADMIN | PROFESSOR | STUDENT
  locale       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professor Professor?
  student   Student?

  @@map("users")
}

// ─── Organization ───

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  programs Program[]

  @@map("departments")
}

model Program {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  groups  Group[]
  courses Course[]

  @@map("programs")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester  Int
  createdAt DateTime @default(now())

  students StudentGroup[]
  courses  CourseGroup[]

  @@map("groups")
}

// ─── People ───

model Professor {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId         String  @unique
  departmentId       String?
  // Bound on first check-in. Subsequent check-ins from a different
  // device hash are flagged as "non vérifié" (suspected account sharing).
  trustedDeviceHash  String?
  trustedDeviceAt    DateTime?

  courses  Course[]
  sessions Session[]

  @@map("professors")
}

model Student {
  id                 String @id @default(cuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId          String @unique
  enrollmentYear     Int
  // Bound on first check-in. Subsequent check-ins from a different
  // device hash are flagged as "non vérifié" (suspected account sharing).
  trustedDeviceHash  String?
  trustedDeviceAt    DateTime?

  groups      StudentGroup[]
  attendances Attendance[]

  @@map("students")
}

model StudentGroup {
  studentId String
  groupId   String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
  @@map("student_groups")
}

// ─── Academics ───

model Room {
  id        String   @id @default(cuid())
  name      String
  building  String?
  latitude  Float
  longitude Float
  radius    Int      @default(100)
  capacity  Int?
  createdAt DateTime @default(now())

  sessions     Session[]
  scheduleRules ScheduleRule[]

  @@map("rooms")
}

model Course {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  programId    String
  program      Program   @relation(fields: [programId], references: [id])
  professorId  String
  professor    Professor @relation(fields: [professorId], references: [id])
  semester     Int
  academicYear String
  totalHours   Int?
  createdAt    DateTime  @default(now())

  groups        CourseGroup[]
  sessions      Session[]
  scheduleRules ScheduleRule[]

  @@map("courses")
}

model CourseGroup {
  courseId String
  groupId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([courseId, groupId])
  @@map("course_groups")
}

// ─── Sessions & Attendance ───

model Session {
  id             String   @id @default(cuid())
  courseId        String
  course         Course   @relation(fields: [courseId], references: [id])
  professorId    String
  professor      Professor @relation(fields: [professorId], references: [id])
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id])
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  // Status is mostly computed from clock time at read time
  // (see lib/session-status.ts). This column stores only manual overrides:
  //   - "CANCELLED" if a professor/admin explicitly cancelled the session
  //   - null/empty otherwise (status derived from startTime/endTime)
  status         String   @default("SCHEDULED")
  qrSecret       String?
  qrRotationSec  Int      @default(10)
  // Link back to the recurring rule that generated this session (if any)
  scheduleRuleId String?
  scheduleRule   ScheduleRule? @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  // Professor attendance — recorded independently of student attendance
  professorStatus     String   @default("ABSENT") // PRESENT | ABSENT | LATE | EXCUSED
  professorScannedAt  DateTime?
  professorVerified   Boolean  @default(false)
  professorLatitude   Float?
  professorLongitude  Float?
  professorDeviceHash String?
  professorVerificationFlags String?
  professorSelfie     String?  // base64 JPEG, see Attendance.selfiePhoto
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances Attendance[]

  @@index([courseId, date])
  @@index([professorId, status])
  @@index([scheduleRuleId])
  @@map("sessions")
}

// Recurring schedule rule. One rule = one weekly slot for a course
// (e.g. "RO-501, every Tuesday 10:30–12:00 in Amphi A, Sep 15 → Jan 20").
// When materialized, generates one Session per matching date in the range.
model ScheduleRule {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id])
  dayOfWeek      Int       // 0 = Sunday, 1 = Monday, …, 6 = Saturday
  startTime      String    // "HH:MM"
  endTime        String    // "HH:MM"
  startDate      DateTime  // first date to consider
  endDate        DateTime  // last date to consider (inclusive)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions Session[]

  @@index([courseId])
  @@index([roomId, dayOfWeek])
  @@map("schedule_rules")
}

model Attendance {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  status     String    @default("ABSENT") // PRESENT | ABSENT | LATE | EXCUSED
  scannedAt  DateTime?
  latitude   Float?
  longitude  Float?
  deviceHash String?
  ipAddress  String?
  verified   Boolean   @default(false)
  // Per-check-in flags accumulated from the four-layer verification.
  // Possible values include: "DEVICE_MISMATCH", "DEVICE_SHARED",
  // "GPS_OUT_OF_RANGE", "GPS_UNAVAILABLE". Comma-separated string.
  verificationFlags String?
  // Front-camera selfie captured at check-in (base64-encoded JPEG, <100 KB).
  // Stored so the prof can review borderline cases at the end of class.
  // Deleted after 30 days by cleanup cron (TODO).
  selfiePhoto String?
  createdAt  DateTime  @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId, sessionId])
  @@map("attendances")
}
